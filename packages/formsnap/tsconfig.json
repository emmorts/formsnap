{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@emmorts/formsnap": ["./src/lib/index.ts"],
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte",
		"vite.config.ts",
		"vitest.config.ts",
		"vitest.browser.config.ts"
	],
	"exclude": ["dist", "node_modules", "src/service-worker.ts", "src/service-worker/**"]
}
