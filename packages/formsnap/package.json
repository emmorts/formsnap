{
	"name": "@emmorts/formsnap",
	"version": "2.3.0",
	"repository": "github:emmorts/formsnap",
	"funding": "https://github.com/sponsors/huntabyte",
	"scripts": {
		"dev": "pnpm watch",
		"build": "pnpm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . --cache",
		"watch": "svelte-package --watch",
		"sync": "svelte-kit sync",
		"test:ui": "vitest --ui"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"author": {
		"name": "Hunter Johnston",
		"url": "https://github.com/huntabyte"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./remote": {
			"types": "./dist/remote/index.d.ts",
			"svelte": "./dist/remote/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.30.2",
		"sveltekit-superforms": "^2.19.0 || ^3.0.0"
	},
	"peerDependenciesMeta": {
		"sveltekit-superforms": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "^5.0.3",
		"bits-ui": "1.8.0",
		"linkedom": "^0.18.13",
		"playwright": "^1.64.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^3.0.0",
		"tailwindcss": "^3.3.6",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"zod": "4.6.5"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"svelte-toolbelt": "^0.10.6"
	},
	"engines": {
		"node": ">=18"
	},
	"sideEffects": false
}
